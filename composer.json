{
    "name": "generoi/wp-security-hardening",
    "type": "wordpress-muplugin",
    "license": "MIT",
    "description": "Security hardening for WordPress that takes no per-site configuration",
    "homepage": "https://github.com/generoi/wp-security-hardening",
    "authors": [
        {
            "name": "Genero",
            "email": "info@genero.fi"
        }
    ],
    "require": {
        "php": ">=8.0.0"
    },
    "require-dev": {
        "laravel/pint": "^1.17",
        "phpunit/phpunit": "^9.0",
        "wp-phpunit/wp-phpunit": "^7.0",
        "yoast/phpunit-polyfills": "^2.0",
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "GeneroWP\\SecurityHardening\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GeneroWP\\SecurityHardening\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint",
        "test": "phpunit",
        "test:wp-env": "wp-env run tests-cli --env-cwd=wp-content/mu-plugins/wp-security-hardening vendor/bin/phpunit",
        "stan": "./vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    }
}
