<?xml version="1.0"?>
<phpunit
    bootstrap="tests/bootstrap.php"
    colors="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
>
    <testsuites>
        <!-- Integration only. These controls are defined by how they interact
             with core's hook order and with other plugins on the same hooks, so
             there is nothing meaningful to assert against mocks. -->
        <testsuite name="integration">
            <directory suffix="Test.php">tests/Integration</directory>
        </testsuite>
    </testsuites>

    <php>
        <!-- wp-env path. Override for DDEV: WP_PHPUNIT__TESTS_CONFIG=tests/wp-tests-config.php -->
        <env name="WP_PHPUNIT__TESTS_CONFIG" value="/var/www/html/wp-config.php" />
    </php>
</phpunit>
